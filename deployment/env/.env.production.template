# portal.munch.co.ke — Phase A template
# Copy to /var/www/portal.munch.co.ke/.env on the VPS only.
# Fill values locally. Never commit a real .env.
# Phase A: generate APP_KEY. Phase B (data import): replace APP_KEY with live key.

APP_NAME=Munch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Use http:// until Let's Encrypt is issued. asset() URLs follow APP_URL.
APP_URL=http://portal.munch.co.ke
APP_MODE=live
APP_INSTALL=true
APP_MEMORY_LIMIT=512M
APP_LOG_LEVEL=error
LOG_CHANNEL=stack
LOG_LEVEL=error

SOFTWARE_VERSION=11.4
SOFTWARE_ID=
PURCHASE_CODE=
BUYER_USERNAME=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_munch
DB_USERNAME=portal_munch
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Set true only after HTTPS works. HTTP Phase A (hosts-file / IP) needs false.
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

FILESYSTEM_DRIVER=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Munch

ABANDONED_CHECKOUT_SEND_VIA_QUEUE=false
ABANDONED_CHECKOUT_SCHEDULE_EVERY_MINUTE=true
ABANDONED_CHECKOUT_SCHEDULE_ON_ONE_SERVER=true
ABANDONED_CHECKOUT_DRAIN_QUEUE_SECONDS=50
ABANDONED_CHECKOUT_REAPER_BATCH=50
ABANDONED_CHECKOUT_STALE_CLAIM_MINUTES=60

ORDER_AUTOMATION_CHUNK_SIZE=50
ORDER_AUTOMATION_SCHEDULE_MINUTES=5

STOREFRONT_CONFIG_CACHE_TTL=120
STOREFRONT_INSTRUMENT_CONFIG=false
LOYALTY_DELIVERY_SMS_INSTRUMENT=true

# Optional — many payment/SMS/Firebase secrets live in the database after Phase B import
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=
RAZOR_KEY=
RAZOR_SECRET=
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
ASSET_URL=
